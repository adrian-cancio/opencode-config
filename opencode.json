{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "{env:OMNIROUTE_BASE_URL}",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "core-router": {
          "name": "core-router"
        }
      }
    }
  },
  "plugin": [
    "./plugins/dotenv.ts",
    "./plugins/route-monitor.ts",
    "./plugins/opencode-loop.ts"
  ],
  "reference": {
    "opencode-config": {
      "path": "~/.config/opencode"
    },
    "code": {
      "path": "~/Code"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit": "ask",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git reset": "ask",
      "git reset *": "ask",
      "git restore": "ask",
      "git restore *": "ask",
      "git clean": "ask",
      "git clean *": "ask",
      "rm *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "Remove-Item": "ask",
      "Remove-Item *": "ask"
    }
  },
  "lsp": {},
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "const path=require('path');const os=require('os');const script=path.join(os.homedir(),'.config','opencode','.opencode','npm-bin-launcher.js');process.argv.splice(1,0,script);require(script);",
        "brave-search-mcp-server"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "const path=require('path');const os=require('os');const script=path.join(os.homedir(),'.config','opencode','.opencode','npm-bin-launcher.js');process.argv.splice(1,0,script);require(script);",
        "mcp-server-browsermcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "const path=require('path');const os=require('os');const script=path.join(os.homedir(),'.config','opencode','.opencode','npm-bin-launcher.js');process.argv.splice(1,0,script);require(script);",
        "mcp-docker-server"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "const path=require('path');const os=require('os');const script=path.join(os.homedir(),'.config','opencode','.opencode','mcp-remote-launcher.js');process.argv.splice(1,0,script);require(script);",
        "github"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "const path=require('path');const os=require('os');const script=path.join(os.homedir(),'.config','opencode','.opencode','mcp-remote-launcher.js');process.argv.splice(1,0,script);require(script);",
        "context7"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "omnicode": {
      "type": "remote",
      "url": "{env:OMNIROUTE_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_MCP_TOKEN}"
      },
      "timeout": 60000,
      "enabled": true
    }
  }
}
