{
  "$schema": "https://opencode.ai/tui.json",
  "diff_style": "auto",
  "plugin": [
    "./plugins/semantic-notifications.ts"
  ],
  "plugin_enabled": {
    "internal:notifications": false
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.9,
    "sounds": {
      "default": "./sounds/default.wav",
      "question": "./sounds/question.wav",
      "permission": "./sounds/permission.wav",
      "error": "./sounds/error.wav",
      "done": "./sounds/done.wav",
      "subagent_done": "./sounds/subagent-done.wav"
    }
  }
}
